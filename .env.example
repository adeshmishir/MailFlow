# ────────────────────────────────────────────────────────────────────────────
# MailFlow environment variables
#
# Copy to `.env` and fill in real values:   cp .env.example .env
# NEVER commit the real `.env` (it is gitignored).
#
# The SAME `.env` is used for local development and for the production Docker
# Compose stack (docker-compose.prod.yml). In production, Compose OVERRIDES
# the infrastructure URLs (DATABASE_URL, REDIS_HOST/PORT, ELASTICSEARCH_URL)
# with Docker-network service names, so only the app-level values below —
# secrets, OAuth, SMTP, limits — are actually loaded from this file.
# ────────────────────────────────────────────────────────────────────────────

# Application
NODE_ENV=development            # docker-compose.prod.yml sets 'production'
PORT=5000
# Required in production. Long random value, e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# Database (PostgreSQL)
# Local dev uses host port 5433 (mapped by docker-compose.yml). Production
# Compose builds DATABASE_URL from POSTGRES_USER/PASSWORD/DB below and talks
# to the `postgres` container directly.
DATABASE_URL=postgresql://mailflow:mailflow@localhost:5433/mailflow?schema=public
POSTGRES_USER=mailflow
# Required in production — use a strong value: `openssl rand -hex 24`
POSTGRES_PASSWORD=mailflow
POSTGRES_DB=mailflow

# Redis / BullMQ
# Local dev / docker-compose.prod.yml: use REDIS_HOST + REDIS_PORT (optional
# REDIS_PASSWORD). Managed providers (Render Key Value, Upstash, Redis Cloud):
# set REDIS_URL to the full connection string instead (redis:// or rediss://
# for TLS). When REDIS_URL is set it takes precedence.
REDIS_HOST=localhost             # Compose overrides to `redis`
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200   # Compose overrides to http://elasticsearch:9200
ELASTICSEARCH_INDEX=mailflow-emails
# Optional API key for externally hosted Elasticsearch (Elastic Cloud, Bonsai).
ELASTICSEARCH_API_KEY=

# Frontend
# Production: public origin of the app, e.g. https://mailflow.example.com
# This drives CORS and post-login redirects.
FRONTEND_URL=http://localhost:5173

# Google OAuth — https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production: public API callback behind your reverse proxy, e.g.
# https://mailflow.example.com/api/auth/google/callback
# Add exactly this URL to Authorized redirect URIs in Google Cloud Console.
GOOGLE_CALLBACK_URL=

# Slack OAuth — https://api.slack.com/apps
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Production: https://mailflow.example.com/api/slack/callback — must match the
# Redirect URL configured on the Slack app EXACTLY.
SLACK_REDIRECT_URI=

# Ethereal SMTP (test-only delivery). Leave empty to mint a throwaway
# Ethereal test account at startup. Messages accepted by Ethereal are NEVER
# delivered to real inboxes — they can only be viewed via the preview URL.
ETHEREAL_HOST=
ETHEREAL_PORT=
ETHEREAL_USER=
ETHEREAL_PASSWORD=

# Production SMTP delivery. When SMTP_HOST + SMTP_USER + SMTP_PASSWORD are all
# set, the app switches from Ethereal test mode to real delivery (Gmail,
# Outlook, SendGrid, or any SMTP provider). See README "Email Delivery".
#
# Gmail example (App Password required; From address must equal SMTP_USER):
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# true = implicit TLS on port 465; false = STARTTLS (default)
SMTP_SECURE=
# true only for relay/API providers (e.g. SendGrid) that allow arbitrary From.
SMTP_ALLOW_ANY_FROM=

# Worker (BullMQ)
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=100
# Internal health-check listener for the worker container (not public).
WORKER_HEALTH_PORT=5010

# Optional Caddy reverse proxy (docker-compose.prod.yml --profile proxy)
# Set the public domain, e.g. mailflow.example.com
MAILFLOW_DOMAIN=