# Application
NODE_ENV=development
PORT=5000

# Database (PostgreSQL)
# Host port 5433 is used when the machine already runs PostgreSQL on 5432 (native service or another container).
DATABASE_URL=postgresql://mailflow:mailflow@localhost:5433/mailflow?schema=public

# Redis / BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Frontend
FRONTEND_URL=http://localhost:5173

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Slack OAuth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=

# Ethereal SMTP
ETHEREAL_HOST=
ETHEREAL_PORT=
ETHEREAL_USER=
ETHEREAL_PASSWORD=

# Worker
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=100